# Copy to .env and fill in. NEVER commit .env.
DB_PASSWORD=change-me
JWT_SECRET=            # openssl rand -base64 48
FIELD_ENCRYPTION_KEY=  # openssl rand -base64 32   (losing this key makes encrypted fields unreadable: back it up)
SITE_ADDRESS=:80       # or your domain, e.g. clinicq.example.com, for automatic HTTPS
SEED_DEMO=true         # creates the demo logins on an empty database; set false for real use
# Email (reminders). Defaults to the demo mail catcher; for real email use SMTP, e.g. Amazon SES:
# MAIL_HOST=email-smtp.us-west-2.amazonaws.com
# MAIL_PORT=587
# MAIL_USER=...
# MAIL_PASSWORD=...
# MAIL_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=no-reply@your-verified-domain.com
